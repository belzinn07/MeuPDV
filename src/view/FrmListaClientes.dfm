inherited FormListaClientes: TFormListaClientes
  Caption = 'Lista de Clientes - MeuPDV'
  ClientWidth = 1108
  Position = poDefault
  StyleElements = [seFont, seClient, seBorder]
  OnDestroy = FormDestroy
  OnResize = FormResize
  ExplicitWidth = 1124
  ExplicitHeight = 639
  TextHeight = 15
  inherited pnlContainer: TPanel
    Width = 1108
    StyleElements = [seFont, seClient, seBorder]
    ExplicitWidth = 1106
    ExplicitHeight = 592
    inherited pnlCabecalho: TPanel
      Width = 1108
      StyleElements = [seFont, seClient, seBorder]
      ExplicitWidth = 1106
      inherited btnTitulo: TSpeedButton
        Width = 1108
        Caption = 'Clientes'
        Images = ImageList1
        ExplicitWidth = 873
      end
      object btnPesquisar: TSpeedButton
        Left = 299
        Top = 24
        Width = 32
        Height = 32
        ImageIndex = 1
        Images = ImageList1
        Flat = True
        OnClick = btnPesquisarClick
      end
      object edtPesquisa: TEdit
        Left = 40
        Top = 24
        Width = 241
        Height = 29
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clWindowText
        Font.Height = -16
        Font.Name = 'Segoe UI'
        Font.Style = []
        ParentFont = False
        TabOrder = 0
        TextHint = 'Pesquisar cliente ...'
        OnKeyDown = edtPesquisaKeyDown
      end
    end
    inherited pnlRodape: TPanel
      Width = 1108
      StyleElements = [seFont, seClient, seBorder]
      ExplicitTop = 528
      ExplicitWidth = 1106
      inherited pnlAltera: TPanel
        StyleElements = [seFont, seClient, seBorder]
        inherited btnAlterar: TSpeedButton
          OnClick = btnAlterarClick
        end
      end
      inherited pnlAdicionar: TPanel
        StyleElements = [seFont, seClient, seBorder]
        inherited btnAdicionar: TSpeedButton
          OnClick = btnAdicionarClick
        end
      end
      inherited pnlExcluir: TPanel
        StyleElements = [seFont, seClient, seBorder]
        inherited btnExcluir: TSpeedButton
          OnClick = btnExcluirClick
        end
      end
    end
    inherited pnlCentral: TPanel
      Width = 1108
      StyleElements = [seFont, seClient, seBorder]
      ExplicitWidth = 1106
      ExplicitHeight = 458
      inherited dbgItens: TDBGrid
        Width = 1108
        DataSource = dsClientes
        Options = [dgTitles, dgIndicator, dgColumnResize, dgColLines, dgRowLines, dgTabs, dgRowSelect, dgConfirmDelete, dgCancelOnExit, dgTitleClick, dgTitleHotTrack]
        OnDblClick = dbgClientesDblClick
        Columns = <
          item
            Expanded = False
            FieldName = 'ID'
            Title.Caption = 'C'#243'digo'
            Width = 88
            Visible = True
          end
          item
            Expanded = False
            FieldName = 'NOME'
            Title.Caption = 'Nome'
            Width = 297
            Visible = True
          end
          item
            Expanded = False
            FieldName = 'CPF'
            Width = 176
            Visible = True
          end
          item
            Expanded = False
            FieldName = 'CNPJ'
            Width = 176
            Visible = True
          end
          item
            Expanded = False
            FieldName = 'TELEFONE'
            Title.Caption = 'Telefone'
            Width = 143
            Visible = True
          end
          item
            Expanded = False
            FieldName = 'EMAIL'
            Title.Caption = 'E-mail'
            Width = 220
            Visible = True
          end>
      end
    end
  end
